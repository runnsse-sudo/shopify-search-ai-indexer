  {% assign runn_config_metafield = app.metafields.runn_storefront.config_v1 %}
  {% assign runn_config = runn_config_metafield.value %}
  {% capture runn_shipping_valid %}{% render 'runn-schema-config-valid', config: runn_config, kind: 'shipping' %}{% endcapture %}
  {% capture runn_returns_valid %}{% render 'runn-schema-config-valid', config: runn_config, kind: 'returns' %}{% endcapture %}
{% assign runn_policy_path = request.path | downcase %}
{% assign runn_root = routes.root_url | downcase %}
{% assign runn_root_last = runn_root | slice: -1, 1 %}
{% if runn_root != blank and runn_root_last != '/' %}{% assign runn_root = runn_root | append: '/' %}{% endif %}
{% assign runn_path_prefix = runn_policy_path | slice: 0, runn_root.size %}
{% if runn_root != blank and runn_path_prefix == runn_root %}
  {% assign runn_policy_path = runn_policy_path | remove_first: runn_root | prepend: '/' %}
{% endif %}
{% assign runn_is_shipping_policy = false %}
{% assign runn_is_return_policy = false %}
{% if runn_config_metafield.type == 'json' and shop.url != blank and shop.name != blank %}
  {% if runn_policy_path == '/pages/leveransinfo' or runn_policy_path == '/policies/shipping-policy' %}
    {% if runn_shipping_valid == 'true' %}{% assign runn_is_shipping_policy = true %}{% endif %}
  {% endif %}
  {% if runn_policy_path == '/policies/refund-policy' %}
    {% if runn_returns_valid == 'true' %}{% assign runn_is_return_policy = true %}{% endif %}
  {% endif %}
{% endif %}
{% if runn_is_shipping_policy or runn_is_return_policy %}
  {% assign runn_store_id = shop.url | append: '/#online-store' %}
  {% capture runn_json %}
    {
      "@context": "https://schema.org",
      "@type": "OnlineStore",
      "@id": {{ runn_store_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
      {% if runn_is_shipping_policy %}, "hasShippingService": {% render 'runn-shipping-policy', config: runn_config, kind: 'service' %}{% endif %}
      {% if runn_is_return_policy %}, "hasMerchantReturnPolicy": {% render 'runn-return-policy', config: runn_config %}{% endif %}
    }
  {% endcapture %}
  {% capture runn_less_than_escape %}\u003c{% endcapture %}
  <script type="application/ld+json" data-added-by="runn-schema-storefront">{{ runn_json | replace: '<', runn_less_than_escape }}</script>
{% endif %}
{% schema %}
{ "name": "Merchant policy schema", "target": "body", "settings": [] }
{% endschema %}
