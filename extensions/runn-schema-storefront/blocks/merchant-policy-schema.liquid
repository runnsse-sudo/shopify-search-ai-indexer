{% assign runn_policy_path = request.path | downcase %}

{% assign runn_config_metafield = app.metafields.runn_storefront.config_v1 %}
{% assign runn_config = runn_config_metafield.value %}

{% assign runn_has_config_metafield = false %}
{% assign runn_use_v1 = false %}

{% if runn_config_metafield != blank %}
  {% assign runn_has_config_metafield = true %}

  {% if runn_config != blank %}
    {% if runn_config.version == 1 %}
      {% assign runn_use_v1 = true %}
    {% endif %}
  {% endif %}
{% endif %}

{% assign runn_shipping_page_candidate = false %}
{% assign runn_return_page_candidate = false %}

{% if runn_policy_path contains '/pages/leveransinfo' or runn_policy_path contains '/policies/shipping-policy' %}
  {% assign runn_shipping_page_candidate = true %}
{% endif %}

{% if runn_policy_path contains '/policies/refund-policy' %}
  {% assign runn_return_page_candidate = true %}
{% endif %}

{% assign runn_is_shipping_policy = false %}
{% assign runn_is_return_policy = false %}

{% if runn_use_v1 %}
  {% if runn_shipping_page_candidate %}
    {% if runn_config.shipping.enabled %}
      {% if runn_config.shipping.country != blank %}
        {% if runn_config.shipping.currency != blank %}
          {% if runn_config.shipping.rate != blank %}
            {% if runn_config.shipping.label != blank %}
              {% assign runn_is_shipping_policy = true %}
            {% endif %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}

  {% if runn_return_page_candidate %}
    {% if runn_config.returns.enabled %}
      {% if runn_config.returns.country != blank %}
        {% if runn_config.returns.periodDays != blank %}
          {% if runn_config.returns.periodDays > 0 %}
            {% if runn_config.returns.method == 'ReturnByMail' %}
              {% if runn_config.returns.fees == 'CustomerResponsibility' %}
                {% if runn_config.returns.refundType == 'FullRefund' %}
                  {% assign runn_is_return_policy = true %}
                {% endif %}
              {% endif %}
            {% endif %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}
{% elsif runn_has_config_metafield == false %}
  {% assign runn_is_shipping_policy = runn_shipping_page_candidate %}
  {% assign runn_is_return_policy = runn_return_page_candidate %}
{% endif %}

{% if runn_is_shipping_policy %}
  {% if runn_use_v1 %}
    {% assign runn_shipping_country = runn_config.shipping.country | upcase %}
    {% assign runn_shipping_currency = runn_config.shipping.currency | upcase %}
    {% assign runn_shipping_rate = runn_config.shipping.rate %}
    {% assign runn_shipping_label = runn_config.shipping.label | strip %}
  {% else %}
    {% assign runn_shipping_country = 'SE' %}
    {% assign runn_shipping_currency = 'SEK' %}
    {% assign runn_shipping_rate = 49 %}
    {% assign runn_shipping_label = 'Standardfrakt Sverige' %}
  {% endif %}

  {% assign runn_shipping_country_slug = runn_shipping_country | downcase %}
  {% assign runn_shipping_id = shop.url | append: '/#shipping-standard-' | append: runn_shipping_country_slug %}
{% endif %}

{% if runn_is_return_policy %}
  {% if runn_use_v1 %}
    {% assign runn_return_country = runn_config.returns.country | upcase %}
    {% assign runn_return_days = runn_config.returns.periodDays %}

    {% assign runn_return_link = runn_config.returns.policyUrl | strip %}

    {% if runn_return_link == blank %}
      {% assign runn_return_link = canonical_url %}
    {% else %}
      {% assign runn_return_link_first_character = runn_return_link | slice: 0, 1 %}

      {% if runn_return_link_first_character == '/' %}
        {% assign runn_return_link = shop.url | append: runn_return_link %}
      {% endif %}
    {% endif %}
  {% else %}
    {% assign runn_return_country = 'SE' %}
    {% assign runn_return_days = 14 %}
    {% assign runn_return_link = canonical_url %}
  {% endif %}

  {% assign runn_return_country_slug = runn_return_country | downcase %}
  {% assign runn_return_policy_id = shop.url | append: '/#return-policy-' | append: runn_return_country_slug %}
{% endif %}

{% if runn_is_shipping_policy or runn_is_return_policy %}
  {% assign runn_store_id = shop.url | append: '/#online-store' %}

  <script
    type="application/ld+json"
    data-added-by="runn-schema-storefront"
  >
    {
      "@context": "https://schema.org",
      "@type": "OnlineStore",
      "@id": {{ runn_store_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      {% if runn_is_shipping_policy %}
      "hasShippingService": {
        "@type": "ShippingService",
        "@id": {{ runn_shipping_id | json }},
        "name": {{ runn_shipping_label | json }},
        {% unless runn_use_v1 %}
        "description": "Ordinarie frakt inom Sverige kostar normalt 49 kr. Fraktalternativ kan variera beroende på försändelse, adress, storlek och vikt.",
        {% endunless %}
        "fulfillmentType": "https://schema.org/FulfillmentTypeDelivery",
        "shippingConditions": {
          "@type": "ShippingConditions",
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": {{ runn_shipping_country | json }}
          },
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": {{ runn_shipping_rate | json }},
            "currency": {{ runn_shipping_currency | json }}
          }
        }
      }{% if runn_is_return_policy %},{% endif %}
      {% endif %}
      {% if runn_is_return_policy %}
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "@id": {{ runn_return_policy_id | json }},
        "applicableCountry": {{ runn_return_country | json }},
        "returnPolicyCountry": {{ runn_return_country | json }},
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": {{ runn_return_days | json }},
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility",
        "refundType": "https://schema.org/FullRefund",
        "merchantReturnLink": {{ runn_return_link | json }}
      }
      {% endif %}
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "Merchant policy schema",
  "target": "body",
  "settings": []
}
{% endschema %}
