// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum IndexabilityState {
  INDEXABLE
  NOT_ACTIVE
  NOT_PUBLISHED
  UNKNOWN_PUBLICATION
  MISSING_URL
}

enum IndexEventType {
  CREATED
  UPDATED
  DELETED
  INITIAL_SCAN
  MANUAL_SCAN
}

enum IndexQueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}

enum IndexProvider {
  INTERNAL
  BING
  INDEXNOW
  GOOGLE
  AI_AUDIT
}

enum IndexQueueAction {
  INDEX
  DEINDEX
}

enum ScanRunStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model Shop {
  id                 String              @id @default(cuid())
  domain             String              @unique
  primaryDomain      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  productIndexStates ProductIndexState[]
  indexEvents        IndexEvent[]
  queueItems         IndexQueueItem[]
  indexAttempts      IndexAttempt[]
  scanRuns           ScanRun[]
}

model ProductIndexState {
  id                  String            @id @default(cuid())
  shopId              String
  shopifyProductGid   String
  legacyProductId     String?
  handle              String?
  canonicalUrl        String?
  candidateUrl        String?
  title               String?
  productStatus       String?
  indexabilityState   IndexabilityState @default(UNKNOWN_PUBLICATION)
  published           Boolean?
  shopifyPublishedAt  DateTime?
  deletedAt           DateTime?
  shopifyUpdatedAt    DateTime?
  contentHash         String?
  previousContentHash String?
  lastDetectedAt      DateTime          @default(now())
  lastQueuedAt        DateTime?
  lastIndexedAt       DateTime?
  lastSeenScanRunId   String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  shop                Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  events              IndexEvent[]
  queueItems          IndexQueueItem[]

  @@unique([shopId, shopifyProductGid])
  @@index([shopId, indexabilityState])
  @@index([shopId, lastSeenScanRunId])
}

model ScanRun {
  id                   String        @id @default(cuid())
  shopId               String
  status               ScanRunStatus @default(PENDING)
  activeKey            String?       @unique
  cursor               String?
  productsProcessed    Int           @default(0)
  productsIndexable    Int           @default(0)
  productsNonIndexable Int           @default(0)
  productsChanged      Int           @default(0)
  queueItemsCreated    Int           @default(0)
  errorsCount          Int           @default(0)
  startedAt            DateTime?
  lastProgressAt       DateTime?
  completedAt          DateTime?
  errorMessage         String?
  batchToken           String?       @unique
  batchClaimedAt       DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  shop                 Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([status, lastProgressAt])
}

model IndexEvent {
  id                       String             @id @default(cuid())
  shopId                   String
  productIndexStateId      String?
  shopifyProductGid        String
  eventType                IndexEventType
  meaningfulContentChanged Boolean
  oldHash                  String?
  newHash                  String?
  metadata                 Json?
  error                    String?
  receivedAt               DateTime           @default(now())
  shop                     Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productIndexState        ProductIndexState? @relation(fields: [productIndexStateId], references: [id], onDelete: SetNull)

  @@index([shopId, receivedAt])
  @@index([shopifyProductGid, eventType])
}

model IndexQueueItem {
  id                  String             @id @default(cuid())
  shopId              String
  productIndexStateId String?
  shopifyProductGid   String
  url                 String?
  provider            IndexProvider      @default(INTERNAL)
  action              IndexQueueAction   @default(INDEX)
  status              IndexQueueStatus   @default(PENDING)
  reason              String
  dedupeKey           String?            @unique
  retryCount          Int                @default(0)
  maxRetries          Int                @default(5)
  nextAttemptAt       DateTime           @default(now())
  claimedAt           DateTime?
  completedAt         DateTime?
  lastError           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  shop                Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productIndexState   ProductIndexState? @relation(fields: [productIndexStateId], references: [id], onDelete: SetNull)
  attempts            IndexAttempt[]

  @@index([status, nextAttemptAt])
  @@index([shopId, shopifyProductGid, provider, action, status])
}

model IndexAttempt {
  id            String         @id @default(cuid())
  shopId        String
  queueItemId   String
  provider      IndexProvider
  attemptNumber Int
  successful    Boolean
  responseCode  Int?
  responseBody  String?
  error         String?
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  queueItem     IndexQueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)

  @@unique([queueItemId, attemptNumber])
  @@index([shopId, provider, startedAt])
}
