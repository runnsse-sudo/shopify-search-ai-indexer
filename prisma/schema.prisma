// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum IndexabilityState {
  INDEXABLE
  NOT_ACTIVE
  NOT_PUBLISHED
  UNKNOWN_PUBLICATION
  MISSING_URL
}

enum IndexEventType {
  CREATED
  UPDATED
  DELETED
  INITIAL_SCAN
  MANUAL_SCAN
}

enum IndexQueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}

enum IndexProvider {
  INTERNAL
  BING
  INDEXNOW
  GOOGLE
  AI_AUDIT
}

enum IndexQueueAction {
  INDEX
  DEINDEX
}

enum ScanRunStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model Shop {
  id                 String              @id @default(cuid())
  domain             String              @unique
  primaryDomain      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  productIndexStates ProductIndexState[]
  indexEvents        IndexEvent[]
  queueItems         IndexQueueItem[]
  indexAttempts      IndexAttempt[]
  scanRuns           ScanRun[]
  webhookReceipts    WebhookReceipt[]
  providerConfig     ShopProviderConfig?
  seoAuditRuns       SeoAuditRun[]
  seoAuditPages      SeoAuditPage[]
}

model ShopProviderConfig {
  id                             String    @id @default(cuid())
  shopId                         String    @unique
  indexNowEnabled                Boolean   @default(false)
  indexNowAllowedHost            String?
  indexNowCredentialCiphertext   String?
  indexNowCredentialIv           String?
  indexNowCredentialTag          String?
  indexNowOwnershipVerifiedAt    DateTime?
  indexNowOwnershipLastCheckedAt DateTime?
  indexNowOwnershipError         String?
  materializationLastRunAt       DateTime?
  indexNowLastRunAt              DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  shop                           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([indexNowEnabled, indexNowOwnershipVerifiedAt])
  @@index([indexNowEnabled, materializationLastRunAt])
  @@index([indexNowEnabled, indexNowLastRunAt])
}

model ProviderAutomationLease {
  key        String    @id
  ownerToken String?
  leaseUntil DateTime?
  updatedAt  DateTime  @updatedAt
}

model WebhookReceipt {
  id                String   @id @default(cuid())
  shopId            String
  webhookId         String
  eventId           String?
  topic             String
  shopifyProductGid String?
  triggeredAt       String?
  processedAt       DateTime @default(now())
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, webhookId])
  @@index([shopId, processedAt])
}

model ProductIndexState {
  id                  String            @id @default(cuid())
  shopId              String
  shopifyProductGid   String
  legacyProductId     String?
  handle              String?
  canonicalUrl        String?
  candidateUrl        String?
  title               String?
  productStatus       String?
  indexabilityState   IndexabilityState @default(UNKNOWN_PUBLICATION)
  published           Boolean?
  shopifyPublishedAt  DateTime?
  deletedAt           DateTime?
  shopifyUpdatedAt    DateTime?
  contentHash         String?
  previousContentHash String?
  lastDetectedAt      DateTime          @default(now())
  lastQueuedAt        DateTime?
  lastIndexedAt       DateTime?
  lastSeenScanRunId   String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  shop                Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  events              IndexEvent[]
  queueItems          IndexQueueItem[]
  seoAuditPages       SeoAuditPage[]

  @@unique([shopId, shopifyProductGid])
  @@index([shopId, indexabilityState])
  @@index([shopId, lastSeenScanRunId])
}

model ScanRun {
  id                   String        @id @default(cuid())
  shopId               String
  status               ScanRunStatus @default(PENDING)
  activeKey            String?       @unique
  cursor               String?
  productsProcessed    Int           @default(0)
  productsIndexable    Int           @default(0)
  productsNonIndexable Int           @default(0)
  productsChanged      Int           @default(0)
  queueItemsCreated    Int           @default(0)
  errorsCount          Int           @default(0)
  startedAt            DateTime?
  lastProgressAt       DateTime?
  completedAt          DateTime?
  errorMessage         String?
  batchToken           String?       @unique
  batchClaimedAt       DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  shop                 Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([status, lastProgressAt])
}

model IndexEvent {
  id                       String             @id @default(cuid())
  shopId                   String
  productIndexStateId      String?
  shopifyProductGid        String
  eventType                IndexEventType
  meaningfulContentChanged Boolean
  oldHash                  String?
  newHash                  String?
  metadata                 Json?
  error                    String?
  receivedAt               DateTime           @default(now())
  shop                     Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productIndexState        ProductIndexState? @relation(fields: [productIndexStateId], references: [id], onDelete: SetNull)

  @@index([shopId, receivedAt])
  @@index([shopifyProductGid, eventType])
}

model IndexQueueItem {
  id                  String             @id @default(cuid())
  shopId              String
  productIndexStateId String?
  shopifyProductGid   String
  url                 String?
  provider            IndexProvider      @default(INTERNAL)
  action              IndexQueueAction   @default(INDEX)
  status              IndexQueueStatus   @default(PENDING)
  reason              String
  dedupeKey           String?            @unique
  retryCount          Int                @default(0)
  maxRetries          Int                @default(5)
  nextAttemptAt       DateTime           @default(now())
  claimedAt           DateTime?
  completedAt         DateTime?
  lastError           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  shop                Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productIndexState   ProductIndexState? @relation(fields: [productIndexStateId], references: [id], onDelete: SetNull)
  attempts            IndexAttempt[]

  @@index([status, nextAttemptAt])
  @@index([shopId, shopifyProductGid, provider, action, status])
}

model IndexAttempt {
  id            String         @id @default(cuid())
  shopId        String
  queueItemId   String
  provider      IndexProvider
  attemptNumber Int
  successful    Boolean
  responseCode  Int?
  responseBody  String?
  error         String?
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  queueItem     IndexQueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)

  @@unique([queueItemId, attemptNumber])
  @@index([shopId, provider, startedAt])
}

enum SeoAuditRunStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model SeoAuditRun {
  id               String            @id @default(cuid())
  shopId           String
  status           SeoAuditRunStatus @default(PENDING)
  activeKey        String?           @unique
  cursorProductGid String?
  pagesProcessed   Int               @default(0)
  pagesSucceeded   Int               @default(0)
  pagesFailed      Int               @default(0)
  criticalCount    Int               @default(0)
  highCount        Int               @default(0)
  mediumCount      Int               @default(0)
  lowCount         Int               @default(0)
  infoCount        Int               @default(0)
  startedAt        DateTime?
  lastProgressAt   DateTime?
  completedAt      DateTime?
  errorMessage     String?
  batchToken       String?           @unique
  batchClaimedAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  pages            SeoAuditPage[]

  @@index([shopId, createdAt])
  @@index([status, lastProgressAt])
}

model SeoAuditPage {
  id                  String             @id @default(cuid())
  runId               String
  shopId              String
  productIndexStateId String?
  shopifyProductGid   String
  requestedUrl        String
  finalUrl            String?
  statusCode          Int?
  redirectChain       Json?
  title               String?
  metaDescription     String?
  h1Count             Int?
  canonicalUrl        String?
  canonicalLinks      Json?
  robotsMeta          Json?
  xRobotsTag          String?
  noindex             Boolean?
  jsonLdScriptCount   Int                @default(0)
  jsonLdTypeCounts    Json?
  jsonLdNodes         Json?
  issues              Json?
  criticalCount       Int                @default(0)
  highCount           Int                @default(0)
  mediumCount         Int                @default(0)
  lowCount            Int                @default(0)
  infoCount           Int                @default(0)
  error               String?
  auditedAt           DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  run                 SeoAuditRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  shop                Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productIndexState   ProductIndexState? @relation(fields: [productIndexStateId], references: [id], onDelete: SetNull)

  @@unique([runId, shopifyProductGid])
  @@index([shopId, auditedAt])
  @@index([runId, statusCode])
  @@index([runId, criticalCount, highCount])
}
